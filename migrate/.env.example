# BioSCom migration environment — copy to migrate/.env (gitignored). NEVER commit real values.

# Service-account key (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/bioscom-ca01a-firebase-adminsdk.json

# Optional override (defaults to the bioscom-ca01a RTDB URL)
# FIREBASE_DATABASE_URL=https://bioscom-ca01a-default-rtdb.europe-west1.firebasedatabase.app

# Password hash parameters (Firebase console → Authentication → Users → ⋮ top-right → Password hash parameters)
FIREBASE_SCRYPT_SIGNER_KEY=
FIREBASE_SCRYPT_SALT_SEPARATOR=
FIREBASE_SCRYPT_ROUNDS=
FIREBASE_SCRYPT_MEM_COST=

# Verification oracle: a real account you control (must exist in the export)
TEST_EMAIL=
TEST_PASSWORD=
